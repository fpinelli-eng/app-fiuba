# Supabase (Project Settings → API Keys). Son públicas: viajan en la web a cada navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: dirección pública del sitio para los buscadores. En Vercel no hace falta (sale del dominio de producción).
NEXT_PUBLIC_SITE_URL=

# Opcional, solo en el servidor (nunca NEXT_PUBLIC_): el Apps Script de los recordatorios publicado como
# aplicación web, para mandar el mail de confirmación de Recordarme al instante (tools/reminders/README.md,
# "Mail de confirmación"). Sin estas dos, sale en la corrida de cada hora.
AVISOS_WEBAPP_URL=
AVISOS_WEBAPP_TOKEN=
